#!/usr/bin/env python3
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SCENES = ROOT / "goldens" / "scenes"
EXPECTED = ROOT / "goldens" / "expected"
BUILD = ROOT / "engine" / "build" / "hostTest"


def find_cli():
    for name in ("nanquim-cli", "nanquim-cli.exe"):
        candidate = BUILD / name
        if candidate.exists():
            return candidate
    sys.exit(f"nanquim-cli not found in {BUILD}; run ./gradlew :engine:hostTest first")


def main(names):
    cli = find_cli()
    scenes = [SCENES / f"{name}.json" for name in names] if names else sorted(SCENES.glob("*.json"))
    EXPECTED.mkdir(parents=True, exist_ok=True)
    for scene in scenes:
        if not scene.exists():
            sys.exit(f"no scene {scene}")
        output = EXPECTED / f"{scene.stem}.png"
        subprocess.run([str(cli), "render", str(scene), str(output)], check=True)
        print(f"updated {output.relative_to(ROOT)}")


if __name__ == "__main__":
    main(sys.argv[1:])
